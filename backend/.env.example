# ── Sécurité ──
# Généré automatiquement par "npm run setup" / "npm start" s'il est vide. Ne jamais le changer après usage (il chiffre les secrets 2FA).
JWT_SECRET=remplacez_par_une_longue_chaine_aleatoire_64_caracteres_minimum

# ── Serveur ──
PORT=3000
NODE_ENV=development
# Dossier PRIVÉ des documents patients. Vide = backend/storage
STORAGE_DIR=
# Dossier de la base de données embarquée. Vide = backend/data/db
DB_DIR=

# ── Double authentification (2FA) ──
# false = non obligatoire (désactivée pour l'instant) · true = imposée au propriétaire et aux administrateurs
REQUIRE_2FA=false

# ── Compte propriétaire créé au premier démarrage (à retirer ensuite) ──
OWNER_EMAIL=proprietaire@exemple.com
OWNER_PASSWORD=MotDePasseTemporaire!2026

# Synchronisation et sauvegarde en ligne (Supabase / PostgreSQL) — automatique dès qu'Internet est disponible
# Réseau sans IPv6 : utilisez l'adresse du « Session pooler » (Supabase → Connect → Session pooler). Mot de passe : @ → %40, # → %23
SUPABASE_DB_URL=
# SUPABASE_SYNC=off            # désactiver temporairement
# SUPABASE_KEEP_BACKUPS=10     # sauvegardes complètes gardées en ligne
# SUPABASE_REGION=us-west-2    # région du projet (accélère la recherche du pooler)
