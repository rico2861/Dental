# ── Base de données ──
DATABASE_URL=postgres://user:password@localhost:5432/dental_light

# ── Sécurité ──
# 64+ caractères aléatoires. Sert aussi à chiffrer les secrets 2FA : ne jamais le changer après usage.
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez_par_une_longue_chaine_aleatoire_64_caracteres_minimum

# ── Serveur ──
PORT=3000
NODE_ENV=development
# Dossier PRIVÉ des documents patients (hors dossier public), à sauvegarder avec la base.
# Vide = backend/storage
STORAGE_DIR=

# ── Utilisés une seule fois par "npm run setup" (à retirer ensuite) ──
OWNER_EMAIL=proprietaire@exemple.com
OWNER_PASSWORD=MotDePasseTemporaire!2026
